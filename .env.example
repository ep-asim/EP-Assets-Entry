# Local development only. Never commit real credentials or service-account JSON files.
CLOUDSQL_INSTANCE_CONNECTION_NAME=project:region:instance
DB_NAME=ep
DB_USER=database-user
DB_PASSWORD=replace-me
DB_PORT=3306
GOOGLE_SERVICE_ACCOUNT_FILE=C:/path/to/service-account.json

# Optional local/Cloud Run protection. Set both to enable HTTP Basic Auth.
APP_SECRET_KEY=replace-with-a-long-random-value
APP_USERNAME=
APP_PASSWORD=
